{
	email {$CADDY_EMAIL}
	# Không quảng bá phiên bản Caddy (giảm thông tin trinh sát cho attacker).
	servers {
		# Bound header/body reads so slow or oversized clients cannot occupy a
		# connection indefinitely. Keep write timeout unset for streamed exports.
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
		max_header_size 32KB
	}
}

# Active upstream health check, chosen per profile with CADDY_APP_HEALTH. The
# high overlay sets "ready": /api/ready answers 503 while the audit WORM sink is
# unreachable or the audit tail is unanchored, and Caddy then stops routing to
# the app (503 at the edge) until readiness recovers. Standard keeps "none":
# its readiness also sheds load, so with one app instance an active check would
# turn a brief overload into a full outage. Probes go straight to the upstream,
# bypassing the public /api/ready block below. One probe every 10s plus the
# Docker healthcheck (30s) stays under READINESS_MAX_ATTEMPTS (12/min).
(app_health_none) {
}

(app_health_ready) {
	health_uri /api/ready
	health_headers {
		Host {$PUBLIC_DOMAIN}
	}
	health_interval 10s
	health_timeout 5s
	health_status 200
	health_fails 2
	health_passes 1
}

{$PUBLIC_DOMAIN} {
	# Production policy: only TLS 1.3; HTTP is redirected below and never serves content.
	tls {
		protocols tls1.3
	}
	encode zstd gzip

	# Enforce the same high-sensitivity upload ceiling at the Internet edge.
	# Caddy returns 413 before FastAPI/Gradio reads more than this amount.
	request_body {
		max_size 1MB
	}

	# ── RFC 9116: kênh báo cáo lỗ hổng có trách nhiệm (Bài 8 §vận hành) ──
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `Contact: mailto:{$CADDY_EMAIL}
		Preferred-Languages: vi, en
		Canonical: https://{$PUBLIC_DOMAIN}/.well-known/security.txt
		Policy: https://{$PUBLIC_DOMAIN}/security-policy
		Expires: {$SECURITY_TXT_EXPIRES}
		` 200
	}

	handle /security-policy {
		header Content-Type "text/plain; charset=utf-8"
		respond `Vulnerability Disclosure Policy

		Only test systems you own or are explicitly authorized to assess.
		Do not access, alter, retain, or disclose other users' data.
		Avoid denial-of-service, social engineering, and destructive testing.
		Report findings to {$CADDY_EMAIL} with reproducible steps and impact.
		We will acknowledge a valid report and coordinate remediation in good faith.
		` 200
	}

	# ── Chặn sớm các đường dẫn trinh sát của stack khác (WordPress/PHP/git) ──
	# Readiness is for the container/orchestrator, never an Internet endpoint.
	# Prevent public callers from consuming the dependency-probe budget.
	@private_ready path /api/ready /api/ready/*
	handle @private_ready {
		respond 404
	}

	# Lọc ở biên rẻ hơn nhiều so với để request đi tới tầng ứng dụng.
	@recon path_regexp recon ^/(wp-admin|wp-login\.php|phpmyadmin|xmlrpc\.php|\.env|\.git/|\.aws/|\.ssh/|config\.php|cgi-bin/)
	handle @recon {
		respond 404
	}

	# ── Chỉ cho phép các HTTP method mà API thực sự dùng ──
	@bad_method not method GET POST PATCH DELETE HEAD OPTIONS
	handle @bad_method {
		respond 405
	}

	# Vé tải xuống là capability sống 60 giây và nằm trong path. Không ghi cả
	# request này vào access log; sự kiện export vẫn được audit trong ứng dụng.
	# Gradio tải ~110 file /assets cùng lúc. Qua HTTP/2 trình duyệt gửi cả loạt
	# một lần, và app trả 503 khi một IP vượt REQUEST_IP_MAX_CONCURRENT (trang
	# kẹt "Loading..."). Cho file tĩnh xếp hàng ở biên qua tối đa 8 kết nối tới
	# app: Caddy chờ thay vì từ chối, giới hạn đồng thời của app giữ nguyên.
	@frontend_assets {
		method GET HEAD
		path /assets/* /static/*
	}
	handle @frontend_assets {
		reverse_proxy app:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				max_conns_per_host 8
			}
			header_up X-Real-IP {remote_host}
		}
	}

	@export_download path /api/exports/*
	log_skip @export_download

	reverse_proxy app:8000 {
		# Giới hạn thời gian để một backend chậm không giữ kết nối vô hạn.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
		# Truyền IP thật để tầng ứng dụng ghi log/rate-limit đúng nguồn.
		header_up X-Real-IP {remote_host}
		# Only here, not on the assets route: each import adds its own prober.
		import app_health_{$CADDY_APP_HEALTH:none}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	log {
		output stdout
		format filter {
			# Defense in depth: không đưa bearer token, cookie hoặc bí mật giữa
			# identity-aware proxy và ứng dụng vào hệ thống tập trung log.
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-Scap-Proxy-Secret delete
			response>headers>Set-Cookie delete
			wrap json
		}
	}
}

# HTTP chỉ để chuyển hướng sang HTTPS; không phục vụ nội dung.
http://{$PUBLIC_DOMAIN} {
	redir https://{host}{uri} permanent
}
