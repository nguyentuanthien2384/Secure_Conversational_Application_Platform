# ========== Secure application (luồng chính) ==========
APP_ENV=development
APP_SECRET_KEY=
# Tạo khóa: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=
# --- Xoay vòng khóa mã hóa (thay thế MASTER_ENCRYPTION_KEY khi cần rotation) ---
# Liệt kê MỌI khóa từng dùng, dạng "version:base64key" ngăn cách bằng dấu phẩy.
# Khóa cũ vẫn cần để giải mã dữ liệu cũ; ACTIVE_KEY_VERSION quyết định khóa nào
# dùng để MÃ HÓA dữ liệu mới. Sau khi chạy scripts/rotate_encryption_key.py và
# xác minh xong, hãy gỡ khóa cũ ra khỏi danh sách.
#   MASTER_ENCRYPTION_KEYS=1:<khoa_cu>,2:<khoa_moi>
#   ACTIVE_KEY_VERSION=2
MASTER_ENCRYPTION_KEYS=
ACTIVE_KEY_VERSION=
DATABASE_URL=sqlite:///./secure_chat.db
POSTGRES_PASSWORD=change-this-before-docker-production
# Tài khoản runtime không sở hữu schema; migration container áp quyền tự động.
APP_DB_PASSWORD=
# Tài khoản chỉ đọc audit_events cho giảng viên/SOC.
AUDITOR_DB_PASSWORD=
REDIS_URL=
# Required by production Docker Compose for the HTTPS reverse proxy.
PUBLIC_DOMAIN=
CADDY_EMAIL=
# RFC 9116 bắt buộc Expires; đặt dưới 1 năm và cập nhật trước khi hết hạn.
SECURITY_TXT_EXPIRES=2027-07-01T00:00:00Z
ACCESS_TOKEN_MINUTES=30
# Tran tuyet doi cho mot chuoi phien: du gia han bao nhieu lan qua
# POST /api/auth/refresh, sau ngan nay gio ke tu lan dang nhap goc van phai
# xac thuc lai tu dau. Khong co no, sliding session = quyen truy cap vinh vien.
SESSION_ABSOLUTE_HOURS=8
REFRESH_WINDOW_SECONDS=60
REFRESH_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
# After LOGIN_MAX_ATTEMPTS failures for an existing account, lock it for this duration.
LOGIN_LOCKOUT_SECONDS=900
# Public registration is capped per source address to reduce automated account creation.
REGISTRATION_WINDOW_SECONDS=3600
REGISTRATION_MAX_ATTEMPTS=5
MESSAGE_WINDOW_SECONDS=60
MESSAGE_MAX_ATTEMPTS=20
# Xác thực hai lớp TOTP
# Issuer xuat hien HAI lan trong otpauth URI nen ten dai lam ma QR day them
# dang ke va kho quet. Giu ngan (<= 8 ky tu) va khong dung dau tieng Viet.
MFA_ISSUER=SCAP
MFA_CHALLENGE_MINUTES=5
MFA_RECOVERY_CODES=10
MFA_WINDOW_SECONDS=300
MFA_MAX_ATTEMPTS=5
ALLOW_DEMO_AI=true
# Hardening bổ sung
# Bỏ 'unsafe-eval' khỏi CSP của UI theo mặc định; chỉ bật lại nếu bản Gradio cần
CSP_ALLOW_UNSAFE_EVAL=false
# Chính sách mật khẩu theo NIST 800-63B-4 (ưu tiên độ dài)
PASSWORD_MIN_LENGTH=15
# Rà mật khẩu lộ qua HIBP k-anonymity (cần mạng ra ngoài; fail-open khi lỗi)
PASSWORD_BREACH_CHECK=false
# Set false in production. Production startup rejects docs when enabled.
DOCS_ENABLED=true
ALLOWED_ORIGINS=
# Danh sách host hợp lệ (chống tấn công Host header / DNS rebinding).
# Bắt buộc ở production. Ví dụ: chat.example.com,www.chat.example.com
ALLOWED_HOSTS=
# Giới hạn số phiên hội thoại mỗi người dùng (chống cạn kiệt tài nguyên).
MAX_SESSIONS_PER_USER=100
# Giới hạn tần suất đổi mật khẩu (chống dò mật khẩu hiện tại qua endpoint này).
PASSWORD_CHANGE_MAX_ATTEMPTS=5
PASSWORD_CHANGE_WINDOW_SECONDS=900

# ========== IDS/IPS tầng ứng dụng (Bài 7) ==========
# Quét chữ ký tấn công trên URL + header, tự chặn nguồn có hành vi xấu.
IDS_ENABLED=true
# Điểm rủi ro tích lũy để chuyển từ phát hiện sang chặn (high=3, medium=2, low=1).
IDS_BLOCK_THRESHOLD=5
IDS_BLOCK_SECONDS=900

# ========== Audit chống giả mạo & SIEM (Bài 1, Bài 7) ==========
# Chuỗi băm HMAC cho audit log; xác minh qua GET /api/admin/audit/verify.
AUDIT_CHAIN_ENABLED=true
# Đẩy mọi sự kiện bảo mật ra stdout dạng JSON một dòng cho Loki/ELK/Wazuh.
SIEM_JSON_LOGS=true

# Chỉ bật khi cần trình diễn bằng dữ liệu mẫu; production luôn từ chối cờ này.
SEED_DEMO_DATA=false

# Tùy chọn: gọi Gemini thật. Không cấu hình thì app dùng phản hồi demo ngoại tuyến.
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Tùy chọn: tạo tài khoản admin lần đầu. Xóa/đổi sau khi bootstrap.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
