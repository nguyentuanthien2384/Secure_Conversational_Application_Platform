# Files executed or mounted inside Linux containers/VPS must keep LF endings,
# even when core.autocrlf=true on Windows checkouts.
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
deploy/*.example text eol=lf
Caddyfile.* text eol=lf
*.caddy text eol=lf
# Preserve registry source bytes so the vendored provenance SHA-256 remains
# valid after checkout on Windows with core.autocrlf=true.
clients/mls_native/vendor/** -text
