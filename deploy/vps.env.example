# Configuration for a NEW demo VPS database, separate from the local .env.
# Run: python -m scripts.prepare_vps init
# Generated secrets live only in the ignored, private deploy/.env.vps.
COMPOSE_PROJECT_NAME=scap-vps-demo
SCAP_ENV_FILE=./deploy/.env.vps
SCAP_APP_IMAGE=scap:vps-demo

# Paste verified name@sha256:<64 lowercase hex> references before deployment.
BASE_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
CADDY_IMAGE=

# No placeholder domain is published. Fill these after buying a domain.
PUBLIC_DOMAIN=
CADDY_EMAIL=
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=
ALLOWED_HOSTS=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_NAME=SCAP
SECURITY_TXT_EXPIRES=
SCAP_EDGE_SUBNET=172.30.45.0/28
SCAP_EDGE_DYNAMIC_RANGE=172.30.45.8/29
SCAP_CADDY_IPV4=172.30.45.2
# direct: SCAP's Caddy owns ports 80/443 (dedicated VPS).
# shared-proxy: another app's Caddy already owns 80/443 on this VPS (e.g. JobFind);
# it terminates HTTPS for PUBLIC_DOMAIN and forwards over a shared Docker network.
SCAP_EDGE_MODE=direct
SCAP_SHARED_EDGE_NETWORK=vps-shared-edge
SCAP_SHARED_SITES_VOLUME=vps-shared-sites
SCAP_FRONT_PROXY_IPV4=172.30.47.2
SCAP_SHARED_CADDY_IPV4=172.30.47.3

APP_ENV=production
SECURITY_PROFILE=standard
KEY_PROVIDER=local
APP_SECRET_KEY=
MASTER_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUDITOR_DB_PASSWORD=
# Compose supplies the actual role password and private Redis address.
DATABASE_URL=postgresql+psycopg://scap_app@db:5432/secure_chat
REDIS_URL=redis://redis:6379/0
DOCS_ENABLED=false
SEED_DEMO_DATA=false
PASSWORD_BREACH_CHECK=true
ALLOW_SELF_REGISTRATION=true
GRADIO_AUTH_MODE=application
CSP_ALLOW_UNSAFE_EVAL=false
CSP_REPORT_ONLY=false
IDS_ENABLED=true
AUDIT_CHAIN_ENABLED=true
SIEM_JSON_LOGS=true
RETENTION_SWEEP_ON_STARTUP=true
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# 3-4 people may share the same classroom NAT. These are starting budgets.
REQUEST_MAX_CONCURRENT=32
REQUEST_MAX_STREAMS=8
REQUEST_IP_MAX_CONCURRENT=16
REQUEST_IP_MAX_STREAMS=4
PASSWORD_MAX_CONCURRENT=1
AI_MAX_CONCURRENT=1
AI_GLOBAL_MAX_ATTEMPTS=20
AI_DAILY_MAX_ATTEMPTS=100
AI_MAX_OUTPUT_TOKENS=512
GRADIO_QUEUE_MAX_SIZE=16
GRADIO_CONCURRENCY_LIMIT=2
GRADIO_RETAINED_EVENTS=64
GRADIO_STATE_CAPACITY=64
UVICORN_LIMIT_CONCURRENCY=64
UVICORN_BACKLOG=64
UVICORN_KEEPALIVE_SECONDS=5
UVICORN_SHUTDOWN_SECONDS=20
REDIS_MAXMEMORY=96mb
REDIS_MAXCLIENTS=128

# Labelled offline AI is intentional for this course demo. No API charge.
# To require real Gemini, fill the key and set ALLOW_DEMO_AI=false.
ALLOW_DEMO_AI=true
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=20

# Email verification/reset/alerts are unavailable until SMTP is configured.
MAIL_BACKEND=disabled
MAIL_FROM='SCAP <no-reply@scap.local>'
MAIL_MAX_PENDING=8
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
